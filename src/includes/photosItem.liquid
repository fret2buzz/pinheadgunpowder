<a
    class="b-photo-item"
    href="https://res.cloudinary.com/vr201/image/upload/pinheadgunpowder/{{ item.public_id }}.webp"
    data-pswp-width="{{ item.width }}"
    data-pswp-height="{{ item.height }}"
    style="--width: {{item.width }}; --height: {{ item.height }};"
>
    <img
        src="https://res.cloudinary.com/vr201/image/upload/h_150/pinheadgunpowder/{{ item.public_id }}.webp"
        loading="lazy"
        width="150"
        height="150"
        alt="{{ item.public_id }}"
    >
</a>
